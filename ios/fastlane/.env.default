# Standardwerte für die Lanes (im Git). Eigene Werte in ios/fastlane/.env (nicht im Git):
#   ASC_KEY_ID=XXXXXXXXXX
#   ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   ASC_KEY_PATH=…          optional, Standard ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
#   ASC_SIGN_WITH_KEY=1     optional: auch lokal über den API-Key signieren (Rolle Admin)
# Der Schlüssel selbst liegt außerhalb des Repos:
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
TESTFLIGHT_GROUP=Tester

# Pflicht-Update: Öffentlicher Link der Gruppe (den öffnet „In TestFlight aktualisieren“) und wie
# lange die Lane höchstens wartet, bis Apple einen neuen Build für die Tester freigibt (Minuten).
TESTFLIGHT_URL=https://testflight.apple.com/join/92YxVdPT
FORCE_UPDATE_WAIT=20

# Fastlane braucht eine UTF-8-Locale. Greift nur, wenn die Shell selbst keine setzt.
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
