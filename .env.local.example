# Vorlage für .env.local (Repo-Wurzel, nicht im Git). Kopieren und mit den Werten des
# Supabase-Projekts füllen (Dashboard → Project Settings → API):
#   cp .env.local.example .env.local
#   flutter run --dart-define-from-file=.env.local
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-oder-anon-key>
